[Unit]
Description=VideoSage autonomous Google Meet worker
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/opt/videosage
EnvironmentFile=/etc/videosage/worker.env
Environment=PYTHONUNBUFFERED=1
Environment=DISPLAY=:99
Environment=XDG_RUNTIME_DIR=/run/videosage
RuntimeDirectory=videosage
RuntimeDirectoryMode=0700
ExecStart=/opt/videosage/deploy/oracle/start_worker.sh
Restart=always
RestartSec=5
TimeoutStopSec=30
OOMPolicy=stop
Nice=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ReadWritePaths=/opt/videosage /run/videosage

[Install]
WantedBy=multi-user.target
