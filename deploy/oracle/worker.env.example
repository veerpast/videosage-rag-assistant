# Worker API authentication. Generate with: openssl rand -hex 32
WORKER_API_TOKEN=replace_with_a_64_character_random_token

# Supabase backend-only credentials. Never expose the service-role key to Streamlit.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace_with_your_service_role_key

# Existing VideoSage AI credentials
GROQ_API_KEY=replace_with_your_groq_api_key
GROQ_LLM_MODEL=llama-3.1-8b-instant
GROQ_STT_MODEL=whisper-large-v3-turbo
GROQ_TRANSLATION_MODEL=whisper-large-v3

# Bot runtime
MEET_BOT_NAME=VideoSage Assistant
PULSE_SINK_NAME=Virtual_Sink
RECORDINGS_DIR=/opt/videosage/recordings
BROWSER_PROFILE_DIR=/opt/videosage/browser-profile
MAX_MEETING_SECONDS=21600
EMPTY_MEETING_GRACE_SECONDS=120
MAX_MEETINGS_PER_USER_PER_DAY=3
PURGE_INTERVAL_SECONDS=3600
KEEP_RECORDINGS=false
